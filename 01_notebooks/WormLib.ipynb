    "                title=f'Red = {rna_name} on membrane | Blue = {rna_name} mRNA in cytosol',\n",
    "                linewidth=3,\n",
    "                contrast=True,\n",
    "                framesize=(10, 5)\n",
    "            )\n",
    "\n",
    "        \n",
    "        # Quantification: number of spots in membranes and cytoplasm\n",
    "        num_spots_in_membranes = spots_in_membranes.shape[0]\n",
